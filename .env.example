# =====================================================================
# Banco da aplicacao (container Docker)
# =====================================================================
APP_DB_USER=text2sql
APP_DB_PASSWORD=troque_esta_senha
APP_DB_NAME=text2sql_app
APP_DB_PORT=5433

# URL usada pelo config.py para conectar no banco da aplicacao
APP_DATABASE_URL=postgresql+psycopg://text2sql:troque_esta_senha@localhost:5433/text2sql_app


# =====================================================================
# Banco alvo consultado pelo agente
# O nome da variavel deve bater com bancos.chave_conexao no banco da app.
# Use um usuario com permissao apenas de leitura.
# =====================================================================
TARGET_DB_VENDAS=postgresql+psycopg://usuario_leitura:senha@host:5432/vendas

# Fixture local (docker/init-target): loja de e-commerce ficticia,
# usuario agente_leitura criado por docker/init-target/03_permissoes.sql
# (credenciais fixture, nao sao segredo real).
TARGET_DB_LOJA=postgresql+psycopg://agente_leitura:leitura_ficticia@localhost:5434/loja


# =====================================================================
# Groq - dormant, nao usado por src/llm.py. Mantido para reverter a
# migracao para OpenRouter se necessario.
# =====================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0

# =====================================================================
# OpenRouter
# =====================================================================
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_TEMPERATURE=0
OPENROUTER_TIMEOUT_SEGUNDOS=60

# =====================================================================
# Agente
# =====================================================================
MAX_ITERACOES=10
MAX_TABELAS_POR_CHAMADA=8
QUERY_TIMEOUT_SEGUNDOS=20


# =====================================================================
# ops-agent (services/ops-agent). Variaveis proprias levam OPS_ porque
# este .env e compartilhado; OPENROUTER_API_KEY, APP_DATABASE_URL e
# LANGFUSE_* sao reaproveitadas.
# =====================================================================
OPS_LEITURA_DATABASE_URL=postgresql+psycopg://agente_leitura:leitura_ficticia@localhost:5434/loja
# Role agente_escrita: docker/init-target/03_permissoes.sql
# (SELECT/INSERT, sem UPDATE/DELETE; credenciais fixture).
OPS_ESCRITA_DATABASE_URL=postgresql+psycopg://agente_escrita:escrita_ficticia@localhost:5434/loja
# Obrigatorio. Modelos gratuitos (:free, openrouter/free, stealth/*) so
# fora de producao: rate limit baixo e o provedor pode usar os prompts.
OPS_MODELO=nvidia/nemotron-3-super-120b-a12b:free
OPS_TEMPERATURA=0
OPS_MAX_TOKENS=2048
OPS_TIMEOUT_LLM_SEGUNDOS=60
OPS_RETRIES_SAIDA=2
OPS_LIMITE_REQUISICOES=8
OPS_MAX_FORNECEDORES_BUSCA=5
OPS_FUSO_HORARIO=America/Sao_Paulo
OPS_IMAGEM_MAX_BYTES=2097152
OPS_STATEMENT_TIMEOUT_SEGUNDOS=10
# Separadas por virgula
OPS_CORS_ORIGENS=http://localhost:5173


# =====================================================================
# Logging (console/stdout). DEBUG liga tambem os logs de duracao de
# cada chamada em repositories/.
# =====================================================================
LOG_LEVEL=INFO

# =====================================================================
# Langfuse (tracing). Sem as duas chaves o tracing fica desligado e a
# aplicacao roda normalmente.
# =====================================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true