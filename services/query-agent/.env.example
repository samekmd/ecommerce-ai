# =====================================================================
# Banco da aplicacao (container Docker)
# =====================================================================
APP_DB_USER=text2sql
APP_DB_PASSWORD=troque_esta_senha
APP_DB_NAME=text2sql_app
APP_DB_PORT=5433

# URL usada pelo config.py para conectar no banco da aplicacao
APP_DATABASE_URL=postgresql+psycopg://text2sql:troque_esta_senha@localhost:5433/text2sql_app


# =====================================================================
# Banco alvo consultado pelo agente
# O nome da variavel deve bater com bancos.chave_conexao no banco da app.
# Use um usuario com permissao apenas de leitura.
# =====================================================================
TARGET_DB_VENDAS=postgresql+psycopg://usuario_leitura:senha@host:5432/vendas

# Fixture local (docker/init-target): loja de e-commerce ficticia,
# usuario agente_leitura criado por docker/init-target/03_permissoes.sql
# (credenciais fixture, nao sao segredo real).
TARGET_DB_LOJA=postgresql+psycopg://agente_leitura:leitura_ficticia@localhost:5434/loja


# =====================================================================
# Groq
# =====================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0


# =====================================================================
# Agente
# =====================================================================
MAX_ITERACOES=10
MAX_TABELAS_POR_CHAMADA=8
QUERY_TIMEOUT_SEGUNDOS=30


# =====================================================================
# Logging (console/stdout). DEBUG liga tambem os logs de duracao de
# cada chamada em repositories/.
# =====================================================================
LOG_LEVEL=INFO